SERPER_API_KEY=
# Automatic fallback provider (see lib/brandability.ts's searchWithFallback)
# — used only if SERPER_API_KEY's provider fails. Not a settable choice.
SERPENT_API_KEY=
# Required for brandability checks (see lib/brandability.ts) — no fallback without it.
KILOCODE_API_KEY=
# Optional — falls back to the pinned model (kilo-auto/small) when unset.
KILOCODE_MODEL=
INSTAGRAM_SESSION_ID=
# Optional HTTP proxy for Instagram checks only, e.g. http://user:pass@host:port
INSTAGRAM_PROXY_URL=
# Optional PRIMARY search: real headless Chrome scraping google.com via a residential proxy (see README)
CHROME_BIN=
GOOGLE_PROXY_URL=
CHROME_HEADFUL=
