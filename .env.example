SERPER_API_KEY=
# Alternative search provider (see lib/searchProvider.ts) — only used if
# SEARCH_PROVIDER=serpent is set. Defaults to "serper" (SERPER_API_KEY above).
SERPENT_API_KEY=
SEARCH_PROVIDER=
# Required for collision checks (see lib/collision.ts) — no fallback without it.
KILOCODE_API_KEY=
# Optional — falls back to the free auto-router model when unset.
KILOCODE_MODEL=
INSTAGRAM_SESSION_ID=
