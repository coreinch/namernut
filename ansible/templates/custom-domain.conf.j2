# Plain HTTP was previously served directly by the same server block as
# HTTPS below (listen 80 and listen 443 ssl on one block) — confirmed live
# (2026-09-28) that this meant http://{{ custom_domain }}/ returned the
# full site over an unencrypted connection with no upgrade anywhere in the
# chain, rather than the 301 a visitor typing (or a stray link using) the
# bare http:// scheme would need. Split into its own block that only
# redirects, so HSTS (set by the app itself, next.config.ts) has an actual
# HTTPS response to attach to on a visitor's very first request instead of
# depending on them already being on https://.
server {
    listen 80;
    listen [::]:80;
    server_name {{ custom_domain }} www.{{ custom_domain }};
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    server_name {{ custom_domain }} www.{{ custom_domain }};
    include snippets/ssl-promptbox.conf;

    # SSE endpoint: nginx buffers proxied responses by default and only
    # flushes them once the upstream connection closes, which silently
    # turns a streaming response into one big chunk delivered at the
    # end — the app's ReadableStream/ SSE events are unaffected, only
    # what nginx does with them in between. proxy_buffering off (plus
    # X-Accel-Buffering, which some upstream layers respect the same
    # way) makes nginx forward each chunk as it arrives instead.
    # proxy_read_timeout is bumped well past nginx's 60s default since a
    # discovery search can run for minutes; the route's 20s heartbeat
    # keeps the connection well under this on every healthy run.
    location /api/discover {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
        proxy_cache off;
        proxy_set_header X-Accel-Buffering no;
        proxy_read_timeout 300s;
    }

    # Worst-case latency budget: two searchWithFallback attempts (12s each,
    # see SEARCH_TIMEOUT_MS in brandability.ts; a third, when
    # TWOCAPTCHA_API_KEY is set) plus completeChat's own two attempts (30s
    # each, see REQUEST_TIMEOUT_MS in kilocode.ts — retries once on
    # kilo-auto/free's documented hang) is up to 84s (96s with the third
    # provider), over nginx's 60s default proxy_read_timeout. This route previously fit under that
    # default (54s worst case) before completeChat gained its retry; without
    # this override, a slow-but-eventually-successful check now risks nginx
    # cutting the connection with a raw 504 before the app's own clean
    # timeout/error handling ever gets a chance to respond.
    location /api/brandability {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_read_timeout 120s;
    }

    location / {
        proxy_pass http://127.0.0.1:{{ app_port }};
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
    }
}
