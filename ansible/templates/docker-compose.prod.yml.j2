services:
  app:
    image: "{{ ghcr_image }}:{{ image_tag }}"
    restart: unless-stopped
    # Chromium (see Dockerfile) spawns helper processes; without an init
    # to reap them, crashed/killed Chrome instances leave zombies behind.
    init: true
    env_file:
      - .env
    ports:
      # 127.0.0.1-only — the nginx vhost is the only public entry point.
      - "127.0.0.1:{{ app_port }}:3000"
