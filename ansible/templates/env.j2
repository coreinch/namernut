# Rendered by the deploy playbook from extra-vars passed at runtime —
# never committed, mode 0600 on disk (see playbooks/deploy.yml). These
# are read by the API routes via process.env at request time; none of
# them are baked into the Docker image.
SERPER_API_KEY={{ serper_api_key }}
# Automatic fallback provider (see lib/brandability.ts's searchWithFallback)
# — used only if SERPER_API_KEY's provider fails. Not a settable choice.
SERPENT_API_KEY={{ serpent_api_key | default('') }}
KILOCODE_API_KEY={{ kilocode_api_key }}
KILOCODE_MODEL={{ kilocode_model }}
INSTAGRAM_SESSION_ID={{ instagram_session_id }}
INSTAGRAM_PROXY_URL={{ instagram_proxy_url | default('') }}
# Real-Chrome search provider (lib/chromeSearch.ts) — PRIMARY, with
# serper/serpent as its fallbacks. The chromium binary is baked into the
# image (see Dockerfile), so it is always on in production. GOOGLE_PROXY_URL
# only routes it through a residential proxy; left empty, Chrome connects
# directly from the server's datacenter IP, which Google will likely
# challenge (the provider backs off and the API fallbacks take over).
CHROME_BIN=/usr/bin/chromium
# Headful on a private Xvfb display (the image ships xvfb): headless Chrome
# gets Google's bot challenge, headful does not — see lib/chromeSearch.ts.
CHROME_HEADFUL=1
GOOGLE_PROXY_URL={{ google_proxy_url | default('') }}
