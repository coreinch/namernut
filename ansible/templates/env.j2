# Rendered by the deploy playbook from extra-vars passed at runtime —
# never committed, mode 0600 on disk (see playbooks/deploy.yml). These
# are read by the API routes via process.env at request time; none of
# them are baked into the Docker image.
SERPER_API_KEY={{ serper_api_key }}
# Automatic fallback provider (see lib/brandability.ts's searchWithFallback)
# — used only if SERPER_API_KEY's provider fails. Not a settable choice.
SERPENT_API_KEY={{ serpent_api_key | default('') }}
KILOCODE_API_KEY={{ kilocode_api_key }}
KILOCODE_MODEL={{ kilocode_model }}
INSTAGRAM_SESSION_ID={{ instagram_session_id }}
INSTAGRAM_PROXY_URL={{ instagram_proxy_url | default('') }}
# Optional third (last-resort) search provider — see lib/twocaptchaSearch.ts.
# Only used if serper and serpent both fail; skipped entirely when empty.
TWOCAPTCHA_API_KEY={{ twocaptcha_api_key | default('') }}
